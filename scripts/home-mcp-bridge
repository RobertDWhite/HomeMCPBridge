#!/usr/bin/env python3
"""Stdio MCP proxy for the HomeMCPBridge macOS app.

HomeKit is owned by the signed app that macOS launches normally. This proxy is
safe for Codex, Claude, and other MCP clients to launch as a command: it only
forwards JSON-RPC lines to the app's authenticated local bridge.
"""

import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import time


APP_PATH = Path(os.environ.get("HOME_MCP_APP", "/Applications/HomeMCPBridge.app"))
CONFIG_PATH = Path.home() / "Library/Application Support/HomeMCPBridge/local-mcp.json"


def launch_app():
    if not APP_PATH.exists():
        raise RuntimeError(f"HomeMCPBridge is not installed at {APP_PATH}")
    subprocess.run(["/usr/bin/open", "-gja", str(APP_PATH)], check=True,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_config():
    with CONFIG_PATH.open("r", encoding="utf-8") as config_file:
        return json.load(config_file)


def forward(message, config, expect_response=True):
    envelope = json.dumps({"token": config["token"], "message": message}).encode("utf-8")
    with socket.create_connection(("127.0.0.1", config["port"]), timeout=10) as client:
        client.sendall(envelope)
        client.shutdown(socket.SHUT_WR)
        chunks = []
        while True:
            chunk = client.recv(65536)
            if not chunk:
                break
            chunks.append(chunk)
    if not chunks and expect_response:
        raise RuntimeError("HomeMCPBridge closed the connection without a response")
    return b"".join(chunks).decode("utf-8") if chunks else None


def request(message):
    parsed_message = json.loads(message)
    expect_response = not str(parsed_message.get("method", "")).startswith("notifications/")

    # Start the signed app first. It stays running and preserves the user’s
    # HomeKit permission, so later requests do not need to launch it again.
    try:
        return forward(message, load_config(), expect_response)
    except (FileNotFoundError, ConnectionError, OSError):
        launch_app()

    deadline = time.monotonic() + 15
    last_error = None
    while time.monotonic() < deadline:
        try:
            return forward(message, load_config(), expect_response)
        except (FileNotFoundError, ConnectionError, OSError) as error:
            last_error = error
            time.sleep(0.25)
    raise RuntimeError(f"HomeMCPBridge did not become available: {last_error}")


for input_line in sys.stdin:
    line = input_line.strip()
    if not line:
        continue
    try:
        response = request(line)
        if response is not None:
            sys.stdout.write(response + "\n")
            sys.stdout.flush()
    except Exception as error:
        sys.stderr.write(f"HomeMCPBridge proxy error: {error}\n")
        sys.stderr.flush()
